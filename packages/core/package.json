{
  "name": "@loopsight/core",
  "description": "The loopsight core: the page bridge, the session hub, the timeline, the rule engine and the generic MCP tools. Knows no library.",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarekkharsa/tanstack-devtools-mcp.git",
    "directory": "packages/core"
  },
  "sideEffects": [
    "./dist/page/index.js"
  ],
  "exports": {
    "./page": {
      "types": "./dist/page/index.d.ts",
      "default": "./dist/page/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
