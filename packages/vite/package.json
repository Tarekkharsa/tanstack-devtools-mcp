{
  "name": "@loopsight/vite",
  "description": "The loopsight host for Vite: connects every page, records hot updates and build errors, and maps stack frames to source lines.",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarekkharsa/loopsight.git",
    "directory": "packages/vite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@loopsight/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=6"
  }
}
